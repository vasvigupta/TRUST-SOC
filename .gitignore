# ─────────────────────────────────
# TRUST-SOC .gitignore
# ─────────────────────────────────

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
*.so

# Data & SQLite Store (large files — do not commit)
data/raw/
data/processed/
data/sample/
*.db
*.db-*
*.sqlite3

# Models (large binaries)
models/*.joblib
models/*.pkl

# Node / Frontend
frontend/node_modules/
frontend/dist/

# Results large binaries / predictions
results/predictions/

# Jupyter Checkpoints
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.code-workspace

# OS
.DS_Store
Thumbs.db

# Streamlit config is kept; temporary session data ignored
.streamlit/*
!.streamlit/config.toml

# Logs & tasks
*.log
